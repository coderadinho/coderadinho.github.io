{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "white",
  "padding": 16,
  "vconcat": [
    {
      "hconcat": [
        {
          "title": "Liking",
          "width": 210,
          "height": 180,
          "layer": [
            {
              "data": {
                "url": "data/cc4-preferences-points.json"
              },
              "transform": [
                {
                  "filter": {
                    "field": "criterion",
                    "equal": "Liking"
                  }
                }
              ],
              "mark": {
                "type": "point",
                "filled": true,
                "size": 15,
                "opacity": 0.9
              },
              "encoding": {
                "x": {
                  "field": "x",
                  "type": "quantitative",
                  "scale": {
                    "domain": [
                      0.4,
                      2.6
                    ]
                  },
                  "axis": {
                    "values": [
                      1,
                      2
                    ],
                    "labelExpr": "datum.value === 1 ? 'AI' : 'Human'",
                    "title": null,
                    "grid": false,
                    "labelAngle": 0,
                    "ticks": false
                  }
                },
                "y": {
                  "field": "rating",
                  "type": "quantitative",
                  "scale": {
                    "domain": [
                      0.8,
                      5.2
                    ]
                  },
                  "title": "Rating",
                  "axis": {
                    "values": [
                      1,
                      2,
                      3,
                      4,
                      5
                    ],
                    "grid": false
                  }
                },
                "color": {
                  "field": "label",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "AI",
                      "Human"
                    ],
                    "range": [
                      "#9933ff",
                      "#00a6ff"
                    ]
                  },
                  "legend": null
                }
              }
            },
            {
              "data": {
                "url": "data/cc4-preferences-means.json"
              },
              "transform": [
                {
                  "filter": {
                    "field": "criterion",
